flowchart TD
  request[XML export request] --> r0
  r0{"export.invalid_name: Empty, oversized or multiline name"} -->|yes| o0["Reject: Pass Configuration or one root metadata name, not a path or a name list."]
  r0 -->|no| r1
  r1{"export.configuration: Exact Configuration or Конфигурация (case insensitive)"} -->|yes| o1["ConfigurationBundle: One Designer process; listFile contains only Configuration; return Configuration.xml and its root Ext files, never other roots."]
  r1 -->|no| r2
  r2{"export.configuration_suffix: Configuration or Конфигурация followed by a dot/suffix"} -->|yes| o2["Reject: Use exactly Configuration, not Configuration.xml or a configuration name with a suffix."]
  r2 -->|no| r3
  r3{"export.named_root: Named metadata root with a type separator"} -->|yes| o3["NamedRoot: Discover ConfigDumpInfo, then export the selected root and its standalone child files; embedded parts stay inside parent XML."]
  r3 -->|no| r4
  r4{"export.missing_type: Any other name"} -->|yes| o4["Reject: objectName must be Configuration or a full metadata name, for example CommonModule.Example."]
