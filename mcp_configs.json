    {
        "id":  "code-index",
        "name":  "Code Index",
        "enabled":  false,
        "command":  "",
        "entry":  "node_modules\\.bin\\code-index-mcp.cmd",
        "rawCommandArguments":  [
                                    "serve",
                                    "--config",
                                    "{APP_DIR}\\mcps\\code-index\\.generated\\runtime\\daemon.toml"
                                ],
        "workingDirectory":  "{APP_DIR}\\mcps\\code-index\\server",
        "internalPort":  11605,
        "externalPort":  11505,
        "mcpPath":  "/mcp",
        "healthPath":  "/healthz",
        "errorLog":  "{APP_DIR}\\mcps\\code-index\\mcp.err.log",
        "environment":  {
                            "CODE_INDEX_HOME":  "{APP_DIR}\\mcps\\code-index\\.generated\\runtime"
                        },
        "installMethod":  "npm",
        "npmPackage":  "@regsorm/code-index-mcp",
        "gitRepository":  "https://github.com/Regsorm/code-index-mcp.git",
        "installVariables":  [
                                 {
                                     "name":  "{CODE_INDEX_PROJECT_PATH}",
                                     "value":  "",
                                     "multiple":  true,
                                     "values":  [

                                                ],
                                     "description":  "Р В РЎвЂ”Р В Р’В°Р В РЎвЂ”Р В РЎвЂќР РЋРЎвЂњ Р В РЎвЂ”Р РЋР вЂљР В РЎвЂўР В Р’ВµР В РЎвЂќР РЋРІР‚С™Р В Р’В° Р В РўвЂР В Р’В»Р РЋР РЏ Р В РЎвЂР В Р вЂ¦Р В РўвЂР В Р’ВµР В РЎвЂќР РЋР С“Р В Р’В°Р РЋРІР‚В Р В РЎвЂР В РЎвЂ Code Index MCP",
                                     "promptOnInstall":  true
                                 }
                             ],
        "commands":  [
                         {
                             "title":  "{1} Init project",
                             "command":  "node_modules\\.bin\\code-index-mcp.cmd",
                             "arguments":  "init --path \"{CODE_INDEX_PROJECT_PATH}\"",
                             "log":  true,
                             "background":  false,
                             "confirmation":  true,
                             "allowedWhileRunning":  false
                         },
                         {
                             "title":  "Index project",
                             "command":  "node_modules\\.bin\\code-index-mcp.cmd",
                             "arguments":  "index \"{CODE_INDEX_PROJECT_PATH}\"",
                             "log":  true,
                             "background":  true,
                             "confirmation":  true,
                             "allowedWhileRunning":  false
                         },
                         {
                             "title":  "Force reindex",
                             "command":  "node_modules\\.bin\\code-index-mcp.cmd",
                             "arguments":  "index \"{CODE_INDEX_PROJECT_PATH}\" --force",
                             "log":  true,
                             "background":  true,
                             "confirmation":  true,
                             "allowedWhileRunning":  false
                         },
                         {
                             "title":  "Clean stale entries",
                             "command":  "node_modules\\.bin\\code-index-mcp.cmd",
                             "arguments":  "clean --path \"{CODE_INDEX_PROJECT_PATH}\"",
                             "log":  true,
                             "background":  false,
                             "confirmation":  true,
                             "allowedWhileRunning":  false
                         },
                         {
                             "title":  "Daemon status",
                             "command":  "node_modules\\.bin\\code-index-mcp.cmd",
                             "arguments":  "daemon status --json",
                             "log":  true,
                             "background":  false,
                             "confirmation":  false,
                             "allowedWhileRunning":  true
                         },
                         {
                             "title":  "Stats",
                             "command":  "node_modules\\.bin\\code-index-mcp.cmd",
                             "arguments":  "stats --path \"{CODE_INDEX_PROJECT_PATH}\" --json",
                             "log":  true,
                             "background":  false,
                             "confirmation":  false,
                             "allowedWhileRunning":  true
                         }
                     ]
    },
    {
        "id":  "vanessa-automation",
        "name":  "Vanessa Automation MCP",
        "enabled":  false,
        "command":  "\"{VA_1CV8C_PATH}\" ENTERPRISE /TESTMANAGER {VA_TEST_MANAGER_CONNECTION_ARGS} /Execute \"{VA_AUTOMATION_EPF}\" /C \"runMcp;mcpPort={INTERNAL_PORT}\"",
        "upstreamMode":  "external-http",
        "upstreamHost":  "localhost",
        "upstreamStartupTimeoutSeconds":  120,
        "entry":  "",
        "rawCommandArguments":  [

                                ],
        "workingDirectory":  "{APP_DIR}\\mcps\\vanessa-automation\\server",
        "internalPort":  9874,
        "externalPort":  11509,
        "mcpPath":  "/mcp",
        "healthPath":  "/healthz",
        "errorLog":  "{APP_DIR}\\mcps\\vanessa-automation\\mcp.err.log",
        "installMethod":  "git",
        "npmPackage":  "",
        "gitRepository":  "https://github.com/Pr-Mex/vanessa-automation.git",
        "builtinTemplate":  "vanessa-automation",
        "install":  {
                        "postInstallCommand":  "resource:Installers.vanessa-automation"
                    },
        "installVariables":  [
                                 {
                                     "name":  "{VA_1CV8C_PATH}",
                                     "value":  "",
                                     "description":  "path to 1cv8c.exe for the 1C test manager session",
                                     "promptOnInstall":  true
                                 },
                                 {
                                     "name":  "{VA_TEST_MANAGER_CONNECTION_ARGS}",
                                     "value":  "",
                                     "description":  "1C test manager connection arguments, for example /IBName\"TestManager\" or /IBConnectionString \"Srvr=\"\"host\"\";Ref=\"\"base\"\";\"",
                                     "promptOnInstall":  true
                                 },
                                 {
                                     "name":  "{VA_TEST_MANAGER_DB_PROJECT}",
                                     "value":  "",
                                     "description":  "1C Database Manager project name for the Vanessa test manager infobase",
                                     "promptOnInstall":  true
                                 },
                                 {
                                     "name":  "{VA_TEST_CLIENT_DB_PROJECT}",
                                     "value":  "",
                                     "description":  "1C Database Manager project name for the tested client infobase",
                                     "promptOnInstall":  true
                                 },
                                 {
                                     "name":  "{VA_AUTOMATION_EPF}",
                                     "value":  "{APP_DIR}\\mcps\\vanessa-automation\\.install\\vanessa-automation.1.2.043.28\\vanessa-automation\\vanessa-automation.epf",
                                     "description":  "path to downloaded Vanessa Automation epf",
                                     "promptOnInstall":  false
                                 },
                                 {
                                     "name":  "{VA_MCP_EXTENSION_PATH}",
                                     "value":  "{APP_DIR}\\mcps\\vanessa-automation\\.install\\client_mcp.cfe",
                                     "description":  "path to downloaded client_mcp.cfe installed into the test manager infobase",
                                     "promptOnInstall":  false
                                 },
                                 {
                                     "name":  "{VA_MCP_EXTENSION_NAME}",
                                     "value":  "client_mcp",
                                     "description":  "1C extension name for the MCP extension in the test manager infobase",
                                     "promptOnInstall":  true
                                 },
                                 {
                                     "name":  "{VA_EXTENSION_PATH}",
                                     "value":  "{APP_DIR}\\mcps\\vanessa-automation\\.install\\VAExtension.1.29.cfe",
                                     "description":  "path to downloaded VAExtension cfe installed into the tested client infobase",
                                     "promptOnInstall":  false
                                 },
                                 {
                                     "name":  "{VA_EXTENSION_NAME}",
                                     "value":  "VAExtension",
                                     "description":  "1C extension name for VAExtension in the tested client infobase",
                                     "promptOnInstall":  true
                                 }
                             ],
        "commands":  [
                         {
                             "title":  "Check 1C platform path",
                             "command":  "powershell.exe",
                             "arguments":  "-NoProfile -ExecutionPolicy Bypass -Command \"$p=\u0027{VA_1CV8C_PATH}\u0027; if([string]::IsNullOrWhiteSpace($p)){ throw \u00271cv8c.exe path is not configured\u0027 }; if(Test-Path -LiteralPath $p -PathType Leaf){ Write-Output (\u0027OK: 1cv8c.exe exists: \u0027 + $p) } else { throw (\u00271cv8c.exe was not found at \u0027 + $p) }\"",
                             "log":  true,
                             "background":  false,
                             "confirmation":  false,
                             "allowedWhileRunning":  true
                         },
                         {
                             "title":  "Check Vanessa Automation file",
                             "command":  "powershell.exe",
                             "arguments":  "-NoProfile -ExecutionPolicy Bypass -Command \"$p=\u0027{VA_AUTOMATION_EPF}\u0027; if([string]::IsNullOrWhiteSpace($p)){ throw \u0027Vanessa Automation file path is not configured\u0027 }; if(Test-Path -LiteralPath $p -PathType Leaf){ Write-Output (\u0027OK: Vanessa Automation file exists: \u0027 + $p) } else { throw (\u0027Vanessa Automation file was not found at \u0027 + $p) }\"",
                             "log":  true,
                             "background":  false,
                             "confirmation":  false,
                             "allowedWhileRunning":  true
                         },
                         {
                             "title":  "Check MCP extension file",
                             "command":  "powershell.exe",
                             "arguments":  "-NoProfile -ExecutionPolicy Bypass -Command \"$p=\u0027{VA_MCP_EXTENSION_PATH}\u0027; if([string]::IsNullOrWhiteSpace($p)){ throw \u0027client MCP extension file path is not configured\u0027 }; if(Test-Path -LiteralPath $p -PathType Leaf){ Write-Output (\u0027OK: client MCP extension file exists: \u0027 + $p) } else { throw (\u0027client MCP extension file was not found at \u0027 + $p) }\"",
                             "log":  true,
                             "background":  false,
                             "confirmation":  false,
                             "allowedWhileRunning":  true
                         },
                         {
                             "title":  "Check VAExtension file",
                             "command":  "powershell.exe",
                             "arguments":  "-NoProfile -ExecutionPolicy Bypass -Command \"$p=\u0027{VA_EXTENSION_PATH}\u0027; if([string]::IsNullOrWhiteSpace($p)){ throw \u0027VAExtension file path is not configured\u0027 }; if(Test-Path -LiteralPath $p -PathType Leaf){ Write-Output (\u0027OK: VAExtension file exists: \u0027 + $p) } else { throw (\u0027VAExtension file was not found at \u0027 + $p) }\"",
                             "log":  true,
                             "background":  false,
                             "confirmation":  false,
                             "allowedWhileRunning":  true
                         },
                         {
                             "Title":  "{1} Install/Update manager MCP extension",
                             "Command":  "{APP_DIR}\\McpControlCenter.exe",
                             "Arguments":  "--onec-db-install-extension --project \"{VA_TEST_MANAGER_DB_PROJECT}\" --extension-file \"{VA_MCP_EXTENSION_PATH}\" --extension-name \"{VA_MCP_EXTENSION_NAME}\"",
                             "Log":  true,
                             "Background":  false,
                             "Confirmation":  true,
                             "AllowedWhileRunning":  false
                         },
                         {
                             "Title":  "{2} Install/Update test client VAExtension",
                             "Command":  "{APP_DIR}\\McpControlCenter.exe",
                             "Arguments":  "--onec-db-install-extension --project \"{VA_TEST_CLIENT_DB_PROJECT}\" --extension-file \"{VA_EXTENSION_PATH}\" --extension-name \"{VA_EXTENSION_NAME}\"",
                             "Log":  true,
                             "Background":  false,
                             "Confirmation":  true,
                             "AllowedWhileRunning":  false
                         },
                         {
                             "Title":  "{3} Probe manager MCP extension",
                             "Command":  "{VA_1CV8C_PATH}",
                             "Arguments":  "DESIGNER {VA_TEST_MANAGER_CONNECTION_ARGS} /DisableStartupDialogs /DumpCfg \"{APP_DIR}\\mcps\\vanessa-automation\\.generated\\probes\\manager-mcp-extension.cfe\" -Extension \"{VA_MCP_EXTENSION_NAME}\" /Out \"{APP_DIR}\\logs\\control-center\\vanessa-automation\\probe-mcp-extension.1c.log\"",
                             "Log":  true,
                             "Background":  false,
                             "Confirmation":  true,
                             "AllowedWhileRunning":  false
                         },
                         {
                             "Title":  "{4} Unlock manager MCP extension flags",
                             "Command":  "{APP_DIR}\\McpControlCenter.exe",
                             "Arguments":  "--onec-db-update-extension-flags --project \"{VA_TEST_MANAGER_DB_PROJECT}\" --extension-name \"{VA_MCP_EXTENSION_NAME}\" --active yes --safe-mode no --unsafe-action-protection no",
                             "Log":  true,
                             "Background":  false,
                             "Confirmation":  true,
                             "AllowedWhileRunning":  false
                         },
                         {
                             "Title":  "{5} Unlock test client VAExtension flags",
                             "Command":  "{APP_DIR}\\McpControlCenter.exe",
                             "Arguments":  "--onec-db-update-extension-flags --project \"{VA_TEST_CLIENT_DB_PROJECT}\" --extension-name \"{VA_EXTENSION_NAME}\" --active yes --safe-mode no --unsafe-action-protection no",
                             "Log":  true,
                             "Background":  false,
                             "Confirmation":  true,
                             "AllowedWhileRunning":  false
                         },
                         {
                             "title":  "MCP tools/list probe",
                             "command":  "{APP_DIR}\\McpControlCenter.exe",
                             "arguments":  "--scenario-connectivity-smoke --mcp vanessa-automation --url \"http://127.0.0.1:{INTERNAL_PORT}{MCP_PATH}\"",
                             "log":  true,
                             "background":  false,
                             "confirmation":  false,
                             "allowedWhileRunning":  true
                         },
                         {
                             "title":  "Check Vanessa MCP root",
                             "command":  "{APP_DIR}\\McpControlCenter.exe",
                             "arguments":  "--scenario-connectivity-smoke --mcp vanessa-automation --url \"http://127.0.0.1:{INTERNAL_PORT}{MCP_PATH}\" --root \"http://127.0.0.1:{INTERNAL_PORT}/\" --expect-root \"MCP server\"",
                             "log":  true,
                             "background":  false,
                             "confirmation":  false,
                             "allowedWhileRunning":  true
                         },
                         {
                             "title":  "Check Vanessa state",
                             "command":  "{APP_DIR}\\McpControlCenter.exe",
                             "arguments":  "--scenario-connectivity-smoke --mcp vanessa-automation --url \"http://127.0.0.1:{INTERNAL_PORT}{MCP_PATH}\" --tool get_VanessaAutomation_state",
                             "log":  true,
                             "background":  false,
                             "confirmation":  false,
                             "allowedWhileRunning":  true
                         },
                         {
                             "title":  "Check test client windows",
                             "command":  "{APP_DIR}\\McpControlCenter.exe",
                             "arguments":  "--scenario-connectivity-smoke --mcp vanessa-automation --url \"http://127.0.0.1:{INTERNAL_PORT}{MCP_PATH}\" --tool get_window_list_testclient",
                             "log":  true,
                             "background":  false,
                             "confirmation":  false,
                             "allowedWhileRunning":  true
                         },
                         {
                             "title":  "Check command interface",
                             "command":  "{APP_DIR}\\McpControlCenter.exe",
                             "arguments":  "--scenario-connectivity-smoke --mcp vanessa-automation --url \"http://127.0.0.1:{INTERNAL_PORT}{MCP_PATH}\" --tool manage_command_interface --tool-args \"{\"\"action\"\":\"\"get_all\"\"}\"",
                             "log":  true,
                             "background":  false,
                             "confirmation":  false,
                             "allowedWhileRunning":  true
                         },
                         {
                             "title":  "Check active form",
                             "command":  "{APP_DIR}\\McpControlCenter.exe",
                             "arguments":  "--scenario-connectivity-smoke --mcp vanessa-automation --url \"http://127.0.0.1:{INTERNAL_PORT}{MCP_PATH}\" --tool get_form_analysis --tool-args \"{\"\"format\"\":\"\"elements\"\"}\"",
                             "log":  true,
                             "background":  false,
                             "confirmation":  false,
                             "allowedWhileRunning":  true
                         }
                     ]
    },
